# 이 파일을 .env 로 복사해서 고친다 (배포 묶음에는 버전이 채워진 .env 가 이미 들어 있다).

# 불러온 앱 이미지 태그 (docker images ingestlens 로 확인)
INGESTLENS_VERSION=

# 불러온 PDF 엔진(ToolPDF) 이미지 태그 (docker images toolpdf 로 확인)
TOOLPDF_VERSION=

# 설정 변경, 문서 삭제, 수집 API(/api/ingest, Open WebUI 로더)에 쓰는 관리자 키. 길고 임의의 문자열로 바꾼다.
RAG_API_KEY=change-me-to-a-long-random-string

# 올린 문서, DB, 벡터가 저장되는 서버 폴더. 백업 대상이다.
INGESTLENS_DATA_DIR=./data

# 사용자가 접속할 포트
INGESTLENS_PORT=8000

# PDF 엔진: auto(ToolPDF 가 응답하면 ToolPDF, 아니면 내장), toolpdf, local(내장 엔진만, ToolPDF 없는 묶음)
RAG_PDF_ENGINE=auto

# PDF 엔진(ToolPDF)의 키와 처리 프로세스 수. 엔진 포트는 밖에 열지 않으므로 키는 비워 둬도 된다.
TOOLPDF_API_KEY=
TOOLPDF_WORKERS=4
