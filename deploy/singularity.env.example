# Singularity/Apptainer 실행 설정. singularity.env 로 복사해서 고친다.
# 배포 묶음에는 이미지 파일 이름이 채워진 singularity.env 가 이미 들어 있다.

# apptainer 또는 singularity 실행 파일. 비우면 PATH 에서 찾는다.
SINGULARITY=

# ---- 앱 ----
APP_SIF=sif/ingestlens-app.sif
INGESTLENS_PORT=8000
INGESTLENS_DATA_DIR=./data
# 설정 변경, 문서 삭제, 수집 API에 쓰는 관리자 키. 길고 임의의 문자열로 바꾼다.
RAG_API_KEY=change-me-to-a-long-random-string
# Singularity 는 호스트 네트워크를 그대로 쓰므로 모델 서버 주소는 127.0.0.1 이다(models.singularity.yaml).
MODELS_YAML=./models.singularity.yaml

# ---- PDF 엔진 (ToolPDF, 묶음의 toolpdf/ 폴더) ----
# 배포 묶음의 singularity.env 에는 실제 파일 이름이 채워져 있다.
TOOLPDF_SIF=toolpdf/toolpdf-<버전>.sif
TOOLPDF_PORT=8095
TOOLPDF_CACHE_DIR=./toolpdf-cache
TOOLPDF_WORKERS=4
# 엔진 포트는 호스트 네트워크에 열리므로 키를 정한다(앱에도 같은 값이 전달된다). 배포 묶음에는 임의의 키가 채워져 있다.
TOOLPDF_API_KEY=

# ---- 모델 서버 (임베딩 + reranker, GPU 프로세스 1개) ----
MODEL_SIF=sif/ingestlens-model-server.sif
CUDA_VISIBLE_DEVICES=0
DEVICE=cuda
MODELS_DIR=./models
EMBED_DIR=bge-m3
EMBED_NAME=bge-m3
RERANK_DIR=bge-reranker-v2-m3
RERANK_NAME=bge-reranker-v2-m3
MS_PORT=8090
MAX_BATCH_TOKENS=65536
MS_API_KEY=
