                  "caption": "Figure 3"}}
    ]},
    {"file": "en_paper_docling.pdf", "cases": [
      {"page": 1, "id": "docling_text", "title": "논문 첫 페이지",
       "expect": {"label": "text", "facts": ["DocLayNet", "TableFormer", "IBM Research"]}},
      {"page": 3, "id": "docling_fig1", "title": "벡터 + 아이콘 파이프라인 그림 (Figure 1)",
       "expect": {"figure_type": "diagram", "figure_facts": ["Parse", "OCR", "Layout", "Table", "JSON"], "caption": "Figure 1"}},
      {"page": 5, "id": "docling_table1", "title": "선 없는 표 (Table 1)",
       "expect": {"facts": ["Apple M3 Max", "6.20 GB"], "table_cells": ["Apple M3 Max", "177 s", "6.20 GB", "Intel(R) Xeon"], "caption": "Table 1"}}
    ]}
  ]
