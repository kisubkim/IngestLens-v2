       "expect": {"label": "text", "facts": ["1940년", "국보 제70호", "유네스코 세계기록유산", "가로 20㎝"]}}
    ]},
    {"file": "ko_image_gyeongbokgung.pdf", "cases": [
      {"page": 3, "id": "gb_photos", "title": "사진이 든 표 (경복궁 궁성의 문)",
       "expect": {"figure_type": "photo", "facts": ["광화문", "건춘문", "영추문", "신무문"], "language": "ko"}}
    ]},
    {"file": "ko_chart_population.pdf", "cases": [
