                  "table_cells": ["합계출산율", "조출생률"]}},
      {"page": 2, "id": "scan_birth", "title": "스캔 차트 + 표 (출생)",
       "expect": {"label": "scanned", "facts": ["20,867", "764명"], "table_cells": ["230,028", "39,456", "3,691", "168,671"]}},
      {"page": 3, "id": "scan_table", "title": "스캔 통계표 (원본 텍스트는 kostat_table_native)",
       "expect": {"label": "scanned", "table_cells": ["302,676", "-123,753", "110,831", "20,867", "28,971", "7,196"]}}
    ]},
    {"file": "ko_mixed_seoul.pdf", "cases": [
      {"page": 3, "id": "seoul_climate", "title": "기후 표 + 본문 (서울특별시)",
       "expect": {"facts": ["1927년 12월 31일", "1,417.9mm"], "table_cells": ["1,417.9", "414.4", "2,143.1"]}}
    ]},
    {"file": "en_scan_naca1135.pdf", "cases": [
      {"page": 2, "id": "naca_text", "title": "영어 스캔 본문 (오래된 OCR 텍스트층에 오류 있음)",
       "expect": {"facts": ["REPORT 1135", "NACA TN 1428", "one-dimensional flow"]}},
      {"page": 4, "id": "naca_table", "title": "영어 스캔 숫자 표 (Table I)",
       "expect": {"facts": ["SUBSONIC FLOW", "SUPERSONIC FLOW", ".01095", ".02191"]}},
      {"page": 5, "id": "naca_chart", "title": "90도 회전된 스캔 차트 (Chart 1)",
       "expect": {"facts": ["Mach number", "mass-flow"]}}
    ]},
    {"file": "en_mixed_nist.pdf", "cases": [
      {"page": 3, "id": "nist_fig1", "title": "다이어그램 이미지 (Zero Trust Access)",
